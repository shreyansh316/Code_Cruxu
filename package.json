{
  "name": "headroom",
  "displayName": "HEADROOM — AI CEO Office",
  "description": "AI-powered CEO operating system inside VS Code. Hierarchical AI organization for planning, executing, and verifying development work.",
  "version": "0.1.0",
  "publisher": "headroom",
  "private": true,
  "engines": {
    "vscode": "^1.100.0",
    "node": ">=22.0.0"
  },
  "categories": [
    "AI",
    "Other"
  ],
  "keywords": [
    "ai",
    "ceo",
    "organization",
    "agent",
    "automation"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "headroom",
          "title": "HEADROOM",
          "icon": "media/headroom-icon.svg"
        }
      ]
    },
    "views": {
      "headroom": [
        {
          "id": "headroom.organizationView",
          "name": "Organization",
          "type": "tree"
        },
        {
          "id": "headroom.objectiveView",
          "name": "Objectives",
          "type": "tree"
        },
        {
          "id": "headroom.taskView",
          "name": "Active Tasks",
          "type": "tree"
        }
      ]
    },
    "commands": [
      {
        "command": "headroom.openDashboard",
        "title": "HEADROOM: Open CEO Dashboard",
        "category": "HEADROOM"
      },
      {
        "command": "headroom.newObjective",
        "title": "HEADROOM: New Objective",
        "category": "HEADROOM"
      },
      {
        "command": "headroom.showStatus",
        "title": "HEADROOM: Show Status",
        "category": "HEADROOM"
      },
      {
        "command": "headroom.pauseExecution",
        "title": "HEADROOM: Pause Execution",
        "category": "HEADROOM"
      },
      {
        "command": "headroom.resumeExecution",
        "title": "HEADROOM: Resume Execution",
        "category": "HEADROOM"
      },
      {
        "command": "headroom.configureProviderCredential",
        "title": "HEADROOM: Configure AI Provider Credential",
        "category": "HEADROOM"
      },
      {
        "command": "headroom.clearProviderCredential",
        "title": "HEADROOM: Clear AI Provider Credential",
        "category": "HEADROOM"
      },
      {
        "command": "headroom.reviewTaskChanges",
        "title": "HEADROOM: Review Task Changes",
        "category": "HEADROOM"
      },
      {
        "command": "headroom.reviewPlan",
        "title": "HEADROOM: Review Execution Plan",
        "category": "HEADROOM"
      }
    ],
    "configuration": {
      "title": "HEADROOM",
      "properties": {
        "headroom.ai.provider": {
          "type": "string",
          "enum": [
            "mock",
            "gemini",
            "openai"
          ],
          "default": "mock",
          "description": "AI provider for HEADROOM agents. Configure provider credentials with the credential commands."
        },
        "headroom.ai.defaultModel": {
          "type": "string",
          "default": "gemini-2.0-flash",
          "description": "Default AI model for standard agent tasks."
        },
        "headroom.ai.reasoningModel": {
          "type": "string",
          "default": "gemini-2.5-pro",
          "description": "AI model for complex reasoning tasks (Director, planning)."
        },
        "headroom.execution.maxRetries": {
          "type": "number",
          "default": 2,
          "minimum": 0,
          "maximum": 5,
          "description": "Maximum retry attempts per task before escalation."
        },
        "headroom.execution.parallelLimit": {
          "type": "number",
          "default": 4,
          "minimum": 1,
          "maximum": 10,
          "description": "Maximum number of tasks to run in parallel."
        },
        "headroom.debug.verbose": {
          "type": "boolean",
          "default": false,
          "description": "Enable verbose logging for debugging."
        }
      }
    },
    "menus": {
      "commandPalette": [
        {
          "command": "headroom.openDashboard"
        },
        {
          "command": "headroom.newObjective"
        },
        {
          "command": "headroom.showStatus"
        },
        {
          "command": "headroom.configureProviderCredential"
        },
        {
          "command": "headroom.clearProviderCredential"
        },
        {
          "command": "headroom.reviewTaskChanges"
        },
        {
          "command": "headroom.reviewPlan"
        }
      ]
    }
  },
  "scripts": {
    "compile": "node esbuild.js",
    "watch": "node esbuild.js --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:vscode": "node ./test/runTest.js",
    "check:sqlite": "node scripts/check-sqlite.js",
    "package": "npm run compile && vsce package --no-dependencies",
    "vscode:prepublish": "npm run compile"
  },
  "dependencies": {
    "better-sqlite3": "^11.0.0"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.0",
    "@vscode/test-electron": "^2.4.0",
    "@vscode/vsce": "^3.9.2",
    "esbuild": "^0.25.12",
    "vitest": "^2.1.0"
  }
}
