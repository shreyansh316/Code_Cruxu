{
  "name": "headroom",
  "displayName": "%extension.displayName%",
  "description": "%extension.description%",
  "version": "0.1.0",
  "publisher": "headroom",
  "private": true,
  "engines": {
    "vscode": "^1.100.0",
    "node": ">=22.0.0"
  },
  "categories": [
    "AI",
    "Other"
  ],
  "keywords": [
    "ai",
    "ceo",
    "organization",
    "agent",
    "automation"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "headroom",
          "title": "%views.container.title%",
          "icon": "media/headroom-icon.svg"
        }
      ]
    },
    "views": {
      "headroom": [
        {
          "id": "headroom.organizationView",
          "name": "%views.organization.name%",
          "type": "tree"
        },
        {
          "id": "headroom.objectiveView",
          "name": "%views.objectives.name%",
          "type": "tree"
        },
        {
          "id": "headroom.taskView",
          "name": "%views.tasks.name%",
          "type": "tree"
        }
      ]
    },
    "commands": [
      {
        "command": "headroom.openDashboard",
        "title": "%command.openDashboard.title%",
        "category": "HEADROOM"
      },
      {
        "command": "headroom.newObjective",
        "title": "%command.newObjective.title%",
        "category": "HEADROOM"
      },
      {
        "command": "headroom.showStatus",
        "title": "%command.showStatus.title%",
        "category": "HEADROOM"
      },
      {
        "command": "headroom.pauseExecution",
        "title": "%command.pauseExecution.title%",
        "category": "HEADROOM"
      },
      {
        "command": "headroom.resumeExecution",
        "title": "%command.resumeExecution.title%",
        "category": "HEADROOM"
      },
      {
        "command": "headroom.configureProviderCredential",
        "title": "%command.configureCredential.title%",
        "category": "HEADROOM"
      },
      {
        "command": "headroom.clearProviderCredential",
        "title": "%command.clearCredential.title%",
        "category": "HEADROOM"
      },
      {
        "command": "headroom.reviewTaskChanges",
        "title": "%command.reviewTaskChanges.title%",
        "category": "HEADROOM"
      },
      {
        "command": "headroom.reviewPlan",
        "title": "%command.reviewPlan.title%",
        "category": "HEADROOM"
      }
    ],
    "configuration": {
      "title": "%configuration.title%",
      "properties": {
        "headroom.ai.provider": {
          "type": "string",
          "enum": [
            "mock",
            "gemini",
            "openai"
          ],
          "default": "mock",
          "description": "%configuration.aiProvider.description%"
        },
        "headroom.ai.defaultModel": {
          "type": "string",
          "default": "gemini-2.0-flash",
          "description": "%configuration.defaultModel.description%"
        },
        "headroom.ai.reasoningModel": {
          "type": "string",
          "default": "gemini-2.5-pro",
          "description": "%configuration.reasoningModel.description%"
        },
        "headroom.execution.maxRetries": {
          "type": "number",
          "default": 2,
          "minimum": 0,
          "maximum": 5,
          "description": "%configuration.maxRetries.description%"
        },
        "headroom.execution.parallelLimit": {
          "type": "number",
          "default": 4,
          "minimum": 1,
          "maximum": 10,
          "description": "%configuration.parallelLimit.description%"
        },
        "headroom.debug.verbose": {
          "type": "boolean",
          "default": false,
          "description": "%configuration.verbose.description%"
        }
      }
    },
    "menus": {
      "commandPalette": [
        {
          "command": "headroom.openDashboard"
        },
        {
          "command": "headroom.newObjective"
        },
        {
          "command": "headroom.showStatus"
        },
        {
          "command": "headroom.configureProviderCredential"
        },
        {
          "command": "headroom.clearProviderCredential"
        },
        {
          "command": "headroom.reviewTaskChanges"
        },
        {
          "command": "headroom.reviewPlan"
        }
      ]
    }
  },
  "scripts": {
    "compile": "node esbuild.js",
    "watch": "node esbuild.js --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:vscode": "node ./test/runTest.js",
    "check:sqlite": "node scripts/check-sqlite.js",
    "package": "npm run compile && vsce package --no-dependencies",
    "vscode:prepublish": "npm run compile"
  },
  "dependencies": {
    "better-sqlite3": "^11.0.0"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.0",
    "@vscode/test-electron": "^2.4.0",
    "@vscode/vsce": "^3.9.2",
    "esbuild": "^0.25.12",
    "vitest": "^2.1.0"
  }
}
