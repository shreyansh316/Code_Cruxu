# ============================================================
# HEADROOM VS Code Extension — .gitignore
# ============================================================

# Build output
/out/
/dist/

# Node modules
/node_modules/

# VS Code packaging
*.vsix

# Environment / secrets — NEVER COMMIT
.env
.env.local
.env.*.local

# Database files — contain runtime data
*.db
*.db-shm
*.db-wal

# Coverage
/coverage/

# TypeScript incremental cache
*.tsbuildinfo

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
*.log

# OS
.DS_Store
Thumbs.db

# VS Code settings (keep workspace settings in .vscode/settings.json)
# DO NOT ignore .vscode/ — it may contain recommended extensions and debug configs

# Testing
/test-results/
/.vscode-test/
/.nyc_output/
