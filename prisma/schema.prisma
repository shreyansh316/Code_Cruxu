// HEADROOM — AI CEO Operating System
// Core Foundation Schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

// ============================================================
// ORGANIZATION HIERARCHY
// ============================================================

model Organization {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  offices  Office[]
  memories Memory[]
}

model Office {
  id             String   @id @default(cuid())
  name           String
  slug           String   @unique
  description    String?
  status         String   @default("ACTIVE") // ACTIVE, PAUSED, ARCHIVED
  organizationId String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])
  departments  Department[]
  headManager  Agent?       @relation("OfficeHead")
  memories     Memory[]
}

model Department {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  status      String   @default("ACTIVE")
  officeId    String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  office   Office   @relation(fields: [officeId], references: [id])
  agents   Agent[]  @relation("DepartmentAgents")
  manager  Agent?   @relation("DepartmentManager")
  memories Memory[]
}

// ============================================================
// AGENTS (CEO, Director, Managers, Employees)
// ============================================================

model Agent {
  id          String   @id @default(cuid())
  name        String
  role        String   // CEO, DIRECTOR, HEAD_MANAGER, DEPT_MANAGER, EMPLOYEE
  specialization String? // e.g., "frontend-architect", "api-developer"
  status      String   @default("IDLE") // IDLE, BUSY, OFFLINE, ERROR
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Hierarchy relations
  managedOfficeId    String? @unique
  managedOffice      Office? @relation("OfficeHead", fields: [managedOfficeId], references: [id])

  managedDepartmentId String? @unique
  managedDepartment   Department? @relation("DepartmentManager", fields: [managedDepartmentId], references: [id])

  departmentId String?
  department   Department? @relation("DepartmentAgents", fields: [departmentId], references: [id])

  // Task relations
  assignedTasks Task[]      @relation("TaskAssignee")
  createdTasks  Task[]      @relation("TaskCreator")

  // Event relations
  emittedEvents Event[]     @relation("EventEmitter")

  // Audit relations
  auditActions  AuditLog[]

  // AI usage tracking
  aiUsages      AIUsage[]
}

// ============================================================
// PROJECTS & TASKS
// ============================================================

model Project {
  id          String   @id @default(cuid())
  name        String
  description String?
  status      String   @default("PLANNING") // PLANNING, ACTIVE, COMPLETED, FAILED, PAUSED
  priority    Int      @default(0)
  objectiveId String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  objective Objective? @relation(fields: [objectiveId], references: [id])
  tasks     Task[]
  memories  Memory[]
}

model Objective {
  id          String   @id @default(cuid())
  title       String
  description String
  status      String   @default("NEW") // NEW, ANALYZING, PLANNING, ACTIVE, COMPLETED, FAILED, PAUSED
  priority    Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  projects  Project[]
  questions DirectorQuestion[]
  memories  Memory[]
}

model DirectorQuestion {
  id          String   @id @default(cuid())
  objectiveId String
  question    String
  answer      String?
  status      String   @default("PENDING") // PENDING, ANSWERED, SKIPPED
  category    String?  // scope, users, features, platform, security, etc.
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  objective Objective @relation(fields: [objectiveId], references: [id])
}

model Task {
  id                 String   @id @default(cuid())
  taskCode           String   @unique // e.g., WD-FE-0042
  title              String
  description        String?
  status             String   @default("CREATED") // CREATED, ASSIGNED, STARTED, IN_PROGRESS, BLOCKED, COMPLETED, FAILED, CANCELLED
  priority           Int      @default(0)
  projectId          String?
  assigneeId         String?
  creatorId          String?
  acceptanceCriteria String?  // JSON array of criteria
  result             String?  // Structured result JSON
  blockerReason      String?
  retryCount         Int      @default(0)
  maxRetries         Int      @default(2)
  tokenBudget        Int?
  timeBudgetMs       Int?
  startedAt          DateTime?
  completedAt        DateTime?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  project      Project?      @relation(fields: [projectId], references: [id])
  assignee     Agent?        @relation("TaskAssignee", fields: [assigneeId], references: [id])
  creator      Agent?        @relation("TaskCreator", fields: [creatorId], references: [id])
  dependencies TaskDependency[] @relation("DependentTask")
  dependents   TaskDependency[] @relation("DependencyTask")
  events       Event[]
  memories     Memory[]
  auditLogs    AuditLog[]
}

model TaskDependency {
  id              String @id @default(cuid())
  dependentTaskId String
  dependencyTaskId String

  dependentTask  Task @relation("DependentTask", fields: [dependentTaskId], references: [id])
  dependencyTask Task @relation("DependencyTask", fields: [dependencyTaskId], references: [id])

  @@unique([dependentTaskId, dependencyTaskId])
}

// ============================================================
// EVENT SYSTEM
// ============================================================

model Event {
  id        String   @id @default(cuid())
  type      String   // TASK_CREATED, TASK_ASSIGNED, TASK_COMPLETED, etc.
  payload   String?  // JSON payload
  sourceId  String?  // Agent who emitted
  taskId    String?  // Related task
  processed Boolean  @default(false)
  createdAt DateTime @default(now())

  source Agent? @relation("EventEmitter", fields: [sourceId], references: [id])
  task   Task?  @relation(fields: [taskId], references: [id])
}

// ============================================================
// MEMORY SYSTEM (Scoped)
// ============================================================

model Memory {
  id             String   @id @default(cuid())
  scope          String   // CEO, DIRECTOR, OFFICE, DEPARTMENT, TASK, PROJECT, DECISION, KNOWLEDGE
  category       String?  // decision, requirement, architecture, lesson, constraint, issue
  title          String
  content        String
  importance     Int      @default(0) // 0=low, 1=medium, 2=high, 3=critical
  verified       Boolean  @default(false)

  // Scoping relations (nullable — only one should be set per scope)
  organizationId String?
  officeId       String?
  departmentId   String?
  taskId         String?
  projectId      String?
  objectiveId    String?

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization? @relation(fields: [organizationId], references: [id])
  office       Office?       @relation(fields: [officeId], references: [id])
  department   Department?   @relation(fields: [departmentId], references: [id])
  task         Task?         @relation(fields: [taskId], references: [id])
  project      Project?      @relation(fields: [projectId], references: [id])
  objective    Objective?    @relation(fields: [objectiveId], references: [id])
}

// ============================================================
// AUDIT LOG
// ============================================================

model AuditLog {
  id        String   @id @default(cuid())
  action    String   // CREATE, UPDATE, DELETE, ASSIGN, COMPLETE, FAIL, ESCALATE, etc.
  entity    String   // Task, Project, Objective, Agent, etc.
  entityId  String
  agentId   String?
  taskId    String?
  details   String?  // JSON with before/after or details
  createdAt DateTime @default(now())

  agent Agent?  @relation(fields: [agentId], references: [id])
  task  Task?   @relation(fields: [taskId], references: [id])
}

// ============================================================
// AI USAGE TRACKING
// ============================================================

model AIUsage {
  id            String   @id @default(cuid())
  agentId       String?
  taskId        String?
  model         String
  inputTokens   Int
  outputTokens  Int
  estimatedCost Float    @default(0)
  durationMs    Int      @default(0)
  purpose       String?  // reasoning, code-generation, review, etc.
  success       Boolean  @default(true)
  createdAt     DateTime @default(now())

  agent Agent? @relation(fields: [agentId], references: [id])
}
