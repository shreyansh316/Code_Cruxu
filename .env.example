# HEADROOM — Environment Configuration
# Copy this file to .env and fill in real values.
# NEVER commit .env to Git.

# ============================================================
# AI PROVIDER
# Set headroom.ai.provider in VS Code settings to 'gemini' or 'openai'
# then configure the API key via VS Code SecretStorage (not here).
# ============================================================

# For local testing only — NOT used in production extension
# The extension uses vscode.SecretStorage for production keys
HEADROOM_AI_PROVIDER=mock

# ============================================================
# DATABASE
# The extension stores its database in VS Code's global storage path.
# This env var is only used for local development/testing outside VS Code.
# ============================================================
HEADROOM_DB_PATH=./headroom-dev.db
